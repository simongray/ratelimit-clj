{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. The library has no other dependencies.
 :deps  {org.clojure/clojure {:mvn/version "1.11.4"}}

 :aliases
 {;; clojure -X:test  (test.check makes the random input of the generative
  ;; tests)
  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -X:test:pedestal  (also the interceptor in Pedestal's own
  ;; chain, which needs Java 17 and Clojure 1.12)
  :pedestal {:extra-paths   ["test-pedestal"]
             :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
             :extra-deps    {io.pedestal/pedestal.interceptor {:mvn/version "0.8.2"}}
             :exec-args     {:dirs ["test" "test-pedestal"]}}

  ;; clojure -M:cljs compile test  (the tests in Node)
  :cljs {:extra-paths   ["test" "dev"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
         :extra-deps    {thheller/shadow-cljs    {:mvn/version "3.5.3"}
                         org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -M:bench -m dk.simongray.ratelimit.bench  (criterium times the
  ;; library, and clj-async-profiler draws flame graphs of it)
  :bench {:extra-paths ["dev"]
          :extra-deps  {criterium/criterium                      {:mvn/version "0.4.6"}
                        com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.8.0"}}
          :jvm-opts    ["-Djdk.attach.allowAttachSelf"
                        "-XX:+UnlockDiagnosticVMOptions"
                        "-XX:+DebugNonSafepoints"]}

  ;; clojure -M:test:bench:nrepl
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          ;; lets nrepl interrupt runaway evaluations
          :jvm-opts   ["-Djdk.attach.allowAttachSelf"]
          :main-opts  ["-m" "nrepl.cmdline"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
